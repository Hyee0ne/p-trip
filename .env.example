# pipeline / Edge Function 용. 실제 값은 .env 에 넣고 절대 커밋하지 않는다.
# 발급처는 docs/TECH_SPEC.md §4 참조.

# 한국관광공사 TourAPI (국문관광정보 GW / 사진 / 연관관광지 / 고캠핑 / 두루누비)
TOURAPI_KEY=

# data.go.kr 공통 (전국전통시장표준데이터, 천문연 출몰시각)
DATA_GO_KR_KEY=

# 한국관광 데이터랩 — CO-01 "조용히 뜨는 길" 변화율
DATALAB_KEY=

# Supabase (pipeline은 service_role 사용 — 앱에는 절대 넣지 않는다)
# ⚠ brrrp 등 다른 프로젝트와 섞이지 않게 EXPECTED_REF 가드가 걸려 있다.
#   두 값이 안 맞으면 파이프라인이 실행을 거부한다 (supabase/README.md 격리 규칙 4).
#   ref 확인: supabase projects list
SUPABASE_URL=
SUPABASE_EXPECTED_REF=
SUPABASE_SERVICE_ROLE_KEY=

# 카카오모빌리티 길찾기 REST — TECH_SPEC §3.7 전용.
# ⚠ Edge Function 안에서만 쓴다. 앱 번들에 넣지 않는다.
KAKAO_MOBILITY_REST_KEY=
