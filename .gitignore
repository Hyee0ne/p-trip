# ── 환경변수 · 키 (절대 커밋 금지) ──
.env
.env.*
!.env.example
*.key
*.jks
*.keystore

# ── 서명·배포 자격증명 (절대 커밋 금지) ──
# .p8  = App Store Connect API 키. **다시 다운로드할 수 없고**, 팀 배포 권한 그 자체다
# .p12 = 인증서 + 개인키. 이것만 있으면 남이 우리 이름으로 앱을 올릴 수 있다
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision

# ── Flutter / Dart ──
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.packages
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh
app/android/.gradle/
app/android/local.properties
app/android/key.properties
app/**/*.g.dart
app/**/*.freezed.dart

# ── Node (pipeline) ──
pipeline/node_modules/
pipeline/dist/
pipeline/.cache/
npm-debug.log*

# ── Supabase ──
supabase/.temp/
supabase/.branches/

# ── macOS / IDE ──
.DS_Store
.idea/
*.iml
.vscode/
dart_defines.json

# 파이프라인 실측 결과 (응답 원문 일부 포함)
pipeline/probe-report.json

# 파일로 받는 원본 데이터 (표준데이터 CSV 등)
pipeline/data/*
!pipeline/data/README.md

# 파이프라인 목록 캐시 — 수만 건이라 커밋하지 않는다. 재실행하면 다시 만들어진다.
pipeline/src/data/candidates.json
