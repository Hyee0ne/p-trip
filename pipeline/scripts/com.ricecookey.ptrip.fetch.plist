<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ricecookey.ptrip.fetch</string>

  <!-- ⚠ cron 이 아니라 launchd 를 쓴다.
       자정에 맥이 자고 있으면 cron 은 그날을 통째로 건너뛴다.
       launchd 는 깨어날 때 밀린 작업을 실행한다. 20일을 하루도 안 버리려면 이쪽이다. -->
  <key>StartCalendarInterval</key>
  <array>
    <!-- TourAPI 일일 한도는 자정(KST)에 리셋된다. 5분 여유를 둔다. -->
    <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>5</integer></dict>
    <!-- 자정에 못 돌았거나 중간에 끊겼을 때를 위한 보험. 이미 받은 건 건너뛴다. -->
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/hyewon/공모전/trip/pipeline/scripts/daily-fetch.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/hyewon/공모전/trip/pipeline</string>

  <!-- 실행 자체가 실패했을 때만 여기 남는다. 정상 로그는 스크립트가 따로 쓴다. -->
  <key>StandardErrorPath</key>
  <string>/Users/hyewon/공모전/trip/pipeline/logs/launchd.err</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
